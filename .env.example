# Copy to .env. Everything is optional: with no key, AgentAudit runs on the offline rule-based judge.

# Enables the Claude judge. (An `ant auth login` profile also works; no key needed then.)
ANTHROPIC_API_KEY=

# auto (default): Claude if credentials exist, otherwise offline rules | claude | heuristic
AGENTAUDIT_JUDGE=auto

# Model and thinking effort for the Claude judge.
AGENTAUDIT_MODEL=claude-opus-5-5
AGENTAUDIT_EFFORT=medium

# SQLite file for audits and the review queue.
AGENTAUDIT_DB=data/agentaudit.db
